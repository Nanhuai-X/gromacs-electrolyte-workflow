#!/usr/bin/env bash
# LOCAL target only. Keep the command explicit and capture its return code.
set -Eeuo pipefail
printf 'hostname=%s\nstart_utc=%s\n' "$(hostname)" "$(date -u +%FT%TZ)"
set +e
{{RUN_COMMAND}}
status=$?
set -e
printf 'end_utc=%s\nreturn_code=%s\n' "$(date -u +%FT%TZ)" "${status}"
exit "$status"
