#!/usr/bin/env bash
# Submit through qsub; do not run a formal calculation on a login node.
set -Eeuo pipefail

#PBS -N {{JOB_NAME}}
#PBS -q {{QUEUE}}
#PBS -l select=1:ncpus={{NCPUS}}:mem={{MEMORY}}
#PBS -l walltime={{WALLTIME}}
#PBS -j oe

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
printf 'hostname=%s\njob_id=%s\nstart_utc=%s\n' "$(hostname)" "${PBS_JOBID:-unknown}" "$(date -u +%FT%TZ)"
set +e
{{RUN_COMMAND}}
status=$?
set -e
printf 'end_utc=%s\nreturn_code=%s\n' "$(date -u +%FT%TZ)" "$status"
exit "$status"
