! WORKFLOW_CP2K_VERSION: 2026.2
! WORKFLOW_NAME: periodic_resp
! WORKFLOW_STATUS: NOT_VALIDATED
! WORKFLOW_SLOT: PROJECT BASIS_FILE POTENTIAL_FILE D3_PARAMETER_FILE CELL_A CELL_B CELL_C COORD_BLOCK KIND_BLOCKS CHARGE CUTOFF_RY REL_CUTOFF_RY EPS_SCF MAX_SCF RESP_FILE
&GLOBAL
  PROJECT {{PROJECT}}
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME {{BASIS_FILE}}
    POTENTIAL_FILE_NAME {{POTENTIAL_FILE}}
    CHARGE {{CHARGE}}
    &MGRID
      CUTOFF {{CUTOFF_RY}}
      REL_CUTOFF {{REL_CUTOFF_RY}}
      COMMENSURATE
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF {{EPS_SCF}}
      MAX_SCF {{MAX_SCF}}
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_KINETIC
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME {{D3_PARAMETER_FILE}}
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A {{CELL_A}} 0.0 0.0
      B 0.0 {{CELL_B}} 0.0
      C 0.0 0.0 {{CELL_C}}
      PERIODIC XYZ
    &END CELL
    &COORD UNIT angstrom
{{COORD_BLOCK}}
    &END COORD
{{KIND_BLOCKS}}
  &END SUBSYS
  &PROPERTIES
    &RESP
      INTEGER_TOTAL_CHARGE TRUE
      STRIDE 2 2 2
      WIDTH 11.249
      &SPHERE_SAMPLING
        AUTO_VDW_RADII_TABLE UFF
      &END SPHERE_SAMPLING
      &PRINT
        &RESP_CHARGES_TO_FILE HIGH
          FILENAME ={{RESP_FILE}}
        &END RESP_CHARGES_TO_FILE
      &END PRINT
    &END RESP
  &END PROPERTIES
&END FORCE_EVAL
